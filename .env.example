

// contact-form-resend-integration
RESEND_API_KEY=
CONTACT_EMAIL_TO=your-email@example.com


# MongoDB connection string. Get this from your MongoDB Atlas cluster
# (or local instance) — Database > Connect > Drivers.
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/
MONGODB_URI=

# Database name to use. Created automatically on first write if it
# doesn't exist yet — no manual setup needed.
MONGODB_DB=raselrana

# Admin panel (/admin). One admin account, email + password.
# ADMIN_EMAIL is the email you log in with.
# Run `npm run hash-password` to generate the next two values — it prints a
# scrypt hash of your password and a random session secret. Never put the
# plain password here.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Base URL of the separately deployed blog app (no trailing slash). /blog is
# rewritten to it by next.config.mjs.
BLOG_DOMAIN=

# Cloudinary — image uploads from the admin dashboard. All uploads go into
# the Cloudinary folder "raselrana-web". Find these three values in the
# Cloudinary console under Settings > API Keys. Keep the secret private.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
